# Copy to deploy/.env and fill in. Never commit the .env file.

# The address your friends type, with no trailing slash.
PUBLIC_URL=https://moonroom.example.com
APP_NAME=MoonRoom

# Run the Cloudflare Tunnel container. Remove this line on a VPS.
COMPOSE_PROFILES=tunnel
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token.
TUNNEL_TOKEN=

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# https://myanimelist.net/apiconfig. The redirect URL there must be PUBLIC_URL + /mal/callback.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# Private deployments only. Playback tries these in order. Known sources: zoko, animesdigital,
# animedrive, local (your own converted files; needs compose.library.yaml, see README).
VIDEO_SOURCES=zoko,animesdigital
# The local library: uncomment both to serve converted episodes from LIBRARY_DIR (read only).
# COMPOSE_FILE=compose.yaml:compose.library.yaml
# LIBRARY_DIR=/mnt/d/moonroom-library
# Private deployments only. Fetches Portuguese synopses from an unlicensed site; English otherwise.
PT_SYNOPSIS_SCRAPE=true

# Only change these when testing over plain http on your own network.
# COOKIE_SECURE=false
# SITE_ADDRESS=:80
