{
  "components": {
    "schemas": {
      "EpisodesOut": {
        "properties": {
          "episodes": {
            "items": {
              "type": "integer"
            },
            "title": "Episodes",
            "type": "array"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "source_title": {
            "title": "Source Title",
            "type": "string"
          }
        },
        "required": [
          "source",
          "source_title",
          "episodes"
        ],
        "title": "EpisodesOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InviteIn": {
        "properties": {
          "days_valid": {
            "default": 7,
            "maximum": 90.0,
            "minimum": 1.0,
            "title": "Days Valid",
            "type": "integer"
          }
        },
        "title": "InviteIn",
        "type": "object"
      },
      "InviteOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "used": {
            "title": "Used",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "expires_at",
          "used"
        ],
        "title": "InviteOut",
        "type": "object"
      },
      "ListUpdate": {
        "properties": {
          "num_watched_episodes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Num Watched Episodes"
          },
          "score": {
            "anyOf": [
              {
                "maximum": 10.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "watching",
                  "completed",
                  "on_hold",
                  "dropped",
                  "plan_to_watch"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "title": "ListUpdate",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_admin": {
            "title": "Is Admin",
            "type": "boolean"
          },
          "locale": {
            "enum": [
              "pt",
              "en"
            ],
            "title": "Locale",
            "type": "string"
          },
          "show_nsfw": {
            "title": "Show Nsfw",
            "type": "boolean"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "locale",
          "show_nsfw",
          "is_admin"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "MeUpdate": {
        "properties": {
          "locale": {
            "anyOf": [
              {
                "enum": [
                  "pt",
                  "en"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale"
          },
          "show_nsfw": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Show Nsfw"
          }
        },
        "title": "MeUpdate",
        "type": "object"
      },
      "PlaybackOut": {
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "resolution": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "resolution",
          "url"
        ],
        "title": "PlaybackOut",
        "type": "object"
      },
      "RefreshIn": {
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshIn",
        "type": "object"
      },
      "RegisterIn": {
        "properties": {
          "invite_code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Invite Code",
            "type": "string"
          },
          "locale": {
            "default": "pt",
            "enum": [
              "pt",
              "en"
            ],
            "title": "Locale",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "pattern": "^[A-Za-z0-9_]{3,32}$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password",
          "invite_code"
        ],
        "title": "RegisterIn",
        "type": "object"
      },
      "TokensOut": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in"
        ],
        "title": "TokensOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
